{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		//Do I need this?
		"allowImportingTsExtensions": true,
		"allowUnusedLabels": false,
		"baseUrl": ".",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "dist",
		//		"paths": {
		//			"@actor": ["types/src/module/actor/index.js"],
		//			"@actor/*": ["types/src/module/actor/*"],
		//			"@item": ["types/src/module/item/index.js"],
		//			"@item/*": ["types/src/module/item/*"],
		//			"@module/*": ["types/src/module/*"],
		//			"@scene": ["types/src/module/scene/index.js"],
		//			"@scene/*": ["types/src/module/scene/*"],
		//			"@scripts/*": ["types/src/scripts/*"],
		//			"@system/*": ["types/src/module/system/*"],
		//			"@util": ["types/src/util/index.js"],
		//			"@util/*": ["types/src/util/*"],
		//			//			"foundryvtt-devMode": ["src/types/devMode.js"],
		//			//			"foundryvtt-devMode": ["src/types/devMode.js"],
		//			//			"devMode": ["src/types/foundryvtt-devMode/devMode.js"]
		//			"styles/*": ["src/styles/*"],
		//			"@static/*": ["static/*"]
		//		},
		"removeComments": false,
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"sourceMap": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": false,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"target": "ESNext",
		"useDefineForClassFields": true,
		"noErrorTruncation": true,
		"types": [
			"node",
			"vite/client",
			"jquery",
			"foundry-pf2e",
			"foundry-pf2e/lib-wrapper",
			"foundry-pf2e/socketlib",
			"tooltipster"
		]
		//		"allowJs": true
	},
	"watchOptions": {
		"excludeDirectories": ["packs/data/", "static/packs/"]
	}
}
